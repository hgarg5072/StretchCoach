rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidCustomRoutine(data) {
      return data.userId == request.auth.uid &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('isCustom' in data) || data.isCustom is bool) &&
             data.stretches is list &&
             data.stretches.size() <= 100 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidPublicRoutine(data) {
      return data.authorId == request.auth.uid &&
             data.authorName is string &&
             data.authorName.size() > 0 &&
             data.authorName.size() <= 100 &&
             data.name is string &&
             data.name.size() > 0 &&
             data.name.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             data.stretches is list &&
             data.stretches.size() > 0 &&
             data.stretches.size() <= 100 &&
             data.cloneCount is int &&
             data.cloneCount >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/custom_routines/{routineId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidCustomRoutine(request.resource.data);
      allow update: if isOwner(userId) &&
                       isValidCustomRoutine(request.resource.data) &&
                       request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/following/{creatorId} {
      allow read, write, delete: if isOwner(userId);
    }

    match /public_routines/{routineId} {
      // Any authenticated user can read public routines
      allow read: if isAuthenticated();

      // Only author can create with valid data
      allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid &&
                       isValidPublicRoutine(request.resource.data);

      // Author can update full routine content; OR any authenticated user can increment cloneCount
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.authorId &&
         isValidPublicRoutine(request.resource.data) &&
         request.resource.data.authorId == resource.data.authorId &&
         request.resource.data.createdAt == resource.data.createdAt)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cloneCount']) &&
         request.resource.data.cloneCount == resource.data.cloneCount + 1)
      );

      // Only the author can delete their shared routine
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
